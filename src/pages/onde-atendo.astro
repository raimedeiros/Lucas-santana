---
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import Icone from '../components/Icone.astro';
import Mapa from '../components/Mapa.astro';
import Base from '../layouts/Base.astro';
import { comoChegarUrl, site } from '../site.config';
// TODO(endereço 915/916): a description abaixo repete "SGAN 915" à mão; ver site.config.ts.
---

<Base
  title="Reumatologista na Asa Norte, Brasília | Lucas Santana"
  description="Consulta particular de Reumatologia na Clínica Mirindiba, SGAN 915, Asa Norte, Brasília. Agendamento pelo WhatsApp. Convênios em locais específicos."
  caminho="/onde-atendo/"
  trilha="Onde Atendo"
>
  <section class="secao topo">
    <div class="container local">
      <div>
        <span class="rotulo">Onde atendo</span>
        <h1 class="titulo-1">Consulta particular</h1>

        <div class="local__bloco">
          <p class="local__titulo">Endereço</p>
          <address>
            <strong>{site.clinica.nome}</strong>{' '}<br />
            {site.clinica.predio}{' '}<br />
            {site.clinica.logradouro}{' '}<br />
            {site.clinica.bairro} — {site.clinica.cidade}/{site.clinica.uf}{' '}<br />
            CEP {site.clinica.cep}
          </address>
          <ul class="local__extras">
            <li>Acessível · elevador · estacionamento · acompanhante bem-vindo</li>
            <li>Também por teleconsulta</li>
          </ul>
        </div>

        <div class="local__bloco">
          <p class="local__titulo">Agendamento e informações</p>
          <p>
            {site.whatsapp.secretaria}{' '}<br />
            WhatsApp: {site.whatsapp.exibicao}
          </p>
        </div>

        <div class="acoes local__acoes">
          <BotaoWhatsApp origem="onde-atendo" texto="Agendar pelo WhatsApp" />
          <a class="botao botao--contorno" href={comoChegarUrl} target="_blank" rel="noopener" data-evento="como-chegar" data-origem="onde-atendo">
            Como chegar
          </a>
        </div>
      </div>
      {/* TODO: fotos do consultório em alta resolução (Google Drive) entram aqui, junto do mapa. */}
      <Mapa />
    </div>
  </section>

  <section class="secao" aria-labelledby="regiao">
    <div class="container">
      <hr class="fio" />
      <div class="duas-colunas regiao">
        <h2 id="regiao" class="titulo-2 revelar">Brasília e região</h2>
        <p class="lead texto revelar">
          O consultório está localizado na Asa Norte e recebe pacientes de diferentes regiões de Brasília e do Distrito
          Federal, além de pessoas que se deslocam de cidades próximas do Entorno, como Valparaíso de Goiás, Cidade
          Ocidental e Luziânia.
        </p>
      </div>
    </div>
  </section>

  <section class="secao fundo-petroleo-tom" id="convenios" aria-labelledby="convenios-titulo">
    <div class="container duas-colunas">
      <div class="revelar">
        <span class="rotulo">Convênios</span>
        <h2 id="convenios-titulo" class="titulo-2">Atendimento por planos de saúde</h2>
      </div>
      <div class="revelar">
        <ul class="convenios">
          {
            site.convenios.map((c) => (
              <li>
                <span class="convenios__nome">{c.nome}</span>
                {c.telefone && c.portal && (
                  <>
                    <div class="acoes convenios__acoes">
                      <a class="botao" href={`tel:${c.telefone}`} data-evento="telefone-convenio" data-origem="onde-atendo">
                        <Icone nome="telefone" />
                        <span>Ligar para a central</span>
                        <span class="sr-only">{c.central}: {c.telefoneExibicao}</span>
                      </a>
                      <a
                        class="botao botao--contorno"
                        href={c.portal}
                        target="_blank"
                        rel="noopener"
                        data-evento="portal-convenio"
                        data-origem="onde-atendo"
                      >
                        Agendar pelo portal
                        <span class="sr-only">(abre em nova aba)</span>
                      </a>
                    </div>
                    <p class="convenios__nota">A cobertura do seu plano é verificada diretamente pelo hospital.</p>
                  </>
                )}
              </li>
            ))
          }
        </ul>
        <p class="texto-secundario texto">
          Os planos aceitos, horários e agendamentos nesses serviços são administrados diretamente pelas respectivas
          instituições.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .local {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .local {
      grid-template-columns: 5fr 6fr;
      gap: 5rem;
    }
  }

  .local__bloco {
    margin-top: 2rem;
  }

  .local__titulo {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cinza-texto);
    margin-bottom: 0.5rem;
  }

  address {
    font-style: normal;
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .local__acoes {
    margin-top: 2.5rem;
  }

  .regiao {
    padding-top: var(--secao);
  }

  .convenios {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
  }

  .convenios li {
    padding-block: 1rem;
    border-bottom: 1px solid rgba(36, 90, 102, 0.25);
  }

  .convenios__nome {
    font-size: 1.1875rem;
  }

  .convenios__acoes {
    margin-top: 1rem;
  }

  .convenios__nota {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--cinza-texto);
  }

  .local__extras {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: grid;
    gap: 0.25rem;
    font-size: 1rem;
    color: var(--grafite);
  }

  .local__extras li::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin: 0 0.625rem 0.15rem 0;
    border-radius: 50%;
    background: var(--petroleo);
  }

  .convenios li:first-child {
    border-top: 1px solid rgba(36, 90, 102, 0.25);
  }
</style>

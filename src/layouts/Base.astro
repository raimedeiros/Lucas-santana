---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Consentimento from '../components/Consentimento.astro';
import CtaFixo from '../components/CtaFixo.astro';
import Fechamento from '../components/Fechamento.astro';
import Rodape from '../components/Rodape.astro';
import { link, site, whatsappUrl } from '../site.config';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico, ex.: '/sobre/'. */
  caminho: string;
  /** Dados estruturados extras desta página (JSON-LD). */
  jsonLd?: Record<string, unknown>[];
  /** Esconde a seção global de fechamento (ex.: 404, privacidade). */
  semFechamento?: boolean;
  /** Nome da página na trilha (breadcrumb). Omitir na Home. */
  trilha?: string;
}

const { title, description, caminho, jsonLd = [], semFechamento = false, trilha } = Astro.props;

const canonical = new URL(caminho, site.dominio).href;
const ogImagem = new URL('/og-image.png', site.dominio).href;
// Enquanto o site não está no domínio próprio, não deixa o Google indexar a cópia de prévia.
const previa = import.meta.env.BASE_URL !== '/';

const medico = {
  '@type': 'Physician',
  '@id': `${site.dominio}/#medico`,
  name: `Dr. ${site.nome}`,
  description: 'Reumatologista em Brasília. Investigação e acompanhamento de doenças reumáticas e autoimunes.',
  url: `${site.dominio}/`,
  image: ogImagem,
  telephone: `+${site.whatsapp.numero}`,
  email: site.email,
  medicalSpecialty: 'Rheumatologic',
  identifier: [
    { '@type': 'PropertyValue', name: 'CRM-DF', value: '27545' },
    { '@type': 'PropertyValue', name: 'RQE Reumatologia', value: '22478' },
    { '@type': 'PropertyValue', name: 'RQE Clínica Médica', value: '24766' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.clinica.logradouro}, ${site.clinica.predio}`,
    addressLocality: site.clinica.cidade,
    addressRegion: site.clinica.uf,
    postalCode: site.clinica.cep,
    addressCountry: 'BR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.clinica.latitude, longitude: site.clinica.longitude },
  areaServed: { '@type': 'City', name: 'Brasília' },
  priceRange: site.consulta.valorExibicao,
  audience: { '@type': 'PeopleAudience', suggestedMinAge: site.consulta.idadeMinima },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.avaliacoesGoogle.nota,
    reviewCount: site.avaliacoesGoogle.total,
    bestRating: 5,
  },
  // Consulta particular, presencial ou por teleconsulta (primeira consulta e retorno).
  makesOffer: {
    '@type': 'Offer',
    price: site.consulta.valor,
    priceCurrency: 'BRL',
    itemOffered: {
      '@type': 'Service',
      name: 'Consulta de Reumatologia (retorno em até 30 dias incluído)',
      availableChannel: [
        { '@type': 'ServiceChannel', name: 'Presencial', serviceLocation: { '@id': `${site.dominio}/#clinica` } },
        { '@type': 'ServiceChannel', name: 'Teleconsulta', serviceUrl: whatsappUrl },
      ],
    },
  },
  sameAs: [site.instagram.url, site.googlePerfil].filter(Boolean),
  workLocation: {
    '@type': 'MedicalClinic',
    '@id': `${site.dominio}/#clinica`,
    name: site.clinica.nome,
    address: {
      '@type': 'PostalAddress',
      streetAddress: `${site.clinica.logradouro}, ${site.clinica.predio}`,
      addressLocality: site.clinica.cidade,
      addressRegion: site.clinica.uf,
      postalCode: site.clinica.cep,
      addressCountry: 'BR',
    },
  },
};

const grafo: Record<string, unknown>[] = [medico, ...jsonLd];
if (trilha) {
  grafo.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.dominio}/` },
      { '@type': 'ListItem', position: 2, name: trilha, item: canonical },
    ],
  });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {previa && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F7F7F5" />

    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={link('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <link rel="manifest" href={link('/site.webmanifest')} />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={`${site.nome} · ${site.especialidade}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nome} — ${site.especialidade} — ${site.crm}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo })} />

    <Analytics />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    {!semFechamento && <Fechamento />}
    <Rodape />
    <CtaFixo />
    <Consentimento />

    <script>
      // Revela seções suavemente ao rolar. Dispara antes de a seção entrar na tela e também revela
      // tudo o que já ficou para trás (rolagem rápida ou pulo por âncora), para nada ficar em branco.
      // O conteúdo só é escondido depois que este script roda: se o JS falhar, tudo fica visível.
      const pendentes = new Set(document.querySelectorAll('.revelar'));
      let agendado = false;
      const revelarVisiveis = () => {
        agendado = false;
        const limite = window.innerHeight * 1.15;
        for (const el of pendentes) {
          if (el.getBoundingClientRect().top < limite) {
            el.classList.add('visivel');
            pendentes.delete(el);
          }
        }
        if (!pendentes.size) {
          window.removeEventListener('scroll', agendar);
          window.removeEventListener('resize', agendar);
        }
      };
      const agendar = () => {
        if (!agendado) {
          agendado = true;
          requestAnimationFrame(revelarVisiveis);
        }
      };
      revelarVisiveis();
      document.documentElement.classList.add('revelar-ativo');
      window.addEventListener('scroll', agendar, { passive: true });
      window.addEventListener('resize', agendar, { passive: true });

      const marcarRolagem = () => document.documentElement.classList.toggle('rolou', window.scrollY > 8);
      marcarRolagem();
      window.addEventListener('scroll', marcarRolagem, { passive: true });
    </script>
  </body>
</html>

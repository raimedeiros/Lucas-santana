---
// Ícones de traço fino (24×24). Usados com moderação, sempre acompanhados de texto.
export interface Props {
  nome:
    | 'whatsapp'
    | 'instagram'
    | 'email'
    | 'mapa'
    | 'roupa'
    | 'unha'
    | 'exames'
    | 'imagem'
    | 'medicamento'
    | 'receita'
    | 'historico'
    | 'camera'
    | 'relogio'
    | 'retorno'
    | 'recibo'
    | 'video'
    | 'acessivel'
    | 'pessoa'
    | 'calendario'
    | 'telefone'
    | 'menu'
    | 'fechar';
  class?: string;
}
const { nome, class: classe } = Astro.props;
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nome === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" />
      <path d="M9.2 8.2c.2-.5.6-.5.9-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .6.5.9 1.3 1.7 2.2 2.2.2.1.4.1.6 0l.6-.5c.2-.1.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3 0 .7-.5.9-.6.3-1.6.5-2.9-.1a9.8 9.8 0 0 1-4.3-4.3c-.6-1.3-.4-2.3-.1-2.9z" fill="currentColor" stroke="none" />
    </>
  )}
  {nome === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
    </>
  )}
  {nome === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6 8.5-6" />
    </>
  )}
  {nome === 'mapa' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {nome === 'roupa' && (
    <path d="M20.4 3.5 16 2a4 4 0 0 1-8 0L3.6 3.5a2 2 0 0 0-1.3 2.2l.6 3.5a1 1 0 0 0 1 .8H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.1a1 1 0 0 0 1-.8l.6-3.5a2 2 0 0 0-1.3-2.2z" />
  )}
  {nome === 'unha' && (
    <>
      <path d="M7.5 22V9.5a4.5 4.5 0 0 1 9 0V22" />
      <path d="M10 10.5V8.2a2 2 0 0 1 4 0v2.3a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z" />
    </>
  )}
  {nome === 'exames' && (
    <>
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
      <path d="M8 13h8M8 17h5M8 9h2" />
    </>
  )}
  {nome === 'imagem' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <path d="M12 6.5v11M9 8.5h6M8.5 11.5h7M9 14.5h6" />
    </>
  )}
  {nome === 'medicamento' && (
    <>
      <path d="m10.5 20.5 10-10a5 5 0 1 0-7-7l-10 10a5 5 0 1 0 7 7z" />
      <path d="m8.5 8.5 7 7" />
    </>
  )}
  {nome === 'receita' && (
    <>
      <rect x="8" y="2" width="8" height="4" rx="1" />
      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
      <path d="M8 11h8M8 15h6" />
    </>
  )}
  {nome === 'historico' && (
    <>
      <path d="M3 12a9 9 0 1 0 2.6-6.3L3 8.3" />
      <path d="M3 3v5.3h5.3" />
      <path d="M12 7.5V12l3.5 2" />
    </>
  )}
  {nome === 'camera' && (
    <>
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" />
      <circle cx="12" cy="13" r="3.3" />

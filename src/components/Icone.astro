  )}
  {nome === 'retorno' && (
    <>
      <path d="M20 12a8 8 0 1 1-2.3-5.7" />
      <path d="M20 4v4.5h-4.5" />
      <path d="m8.5 12 2.5 2.5 4.5-5" />
    </>
  )}
  {nome === 'recibo' && (
    <>
      <path d="M5 3h14v18l-2.3-1.5L14.3 21 12 19.5 9.7 21l-2.4-1.5L5 21z" />
      <path d="M8.5 8h7M8.5 12h7M8.5 16h4" />
    </>
  )}
  {nome === 'video' && (
    <>
      <rect x="2.5" y="6" width="13" height="12" rx="2" />
      <path d="m15.5 10.5 6-3.5v10l-6-3.5" />
    </>
  )}
  {nome === 'acessivel' && (
    <>
      <circle cx="12" cy="4" r="1.6" />
      <path d="M5 8.5c2.3.6 4.7.9 7 .9s4.7-.3 7-.9" />
      <path d="M12 9.4V14m0 0-3 7m3-7 3 7" />
    </>
  )}
  {nome === 'pessoa' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </>
  )}
  {nome === 'calendario' && (
    <>
      <rect x="3" y="4.5" width="18" height="16.5" rx="2" />
      <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
    </>
  )}
  {nome === 'telefone' && (
    <path d="M21 16.4v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.6 2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L7.1 9.4a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
  )}
  {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>

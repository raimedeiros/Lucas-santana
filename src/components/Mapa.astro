---
// Mapa da Clínica Mirindiba. Só carrega o Google Maps quando a pessoa clica (página leve, sem cookies antes da hora).
import { comoChegarUrl, mapaEmbedUrl, site } from '../site.config';
import Icone from './Icone.astro';
---

<div class="mapa" data-mapa={mapaEmbedUrl}>
  <div class="mapa__capa">
    <Icone nome="mapa" />
    <p>
      <strong>{site.clinica.predio}</strong>{' '}<br />
      {site.clinica.logradouro}{' '}<br />
      {site.clinica.bairro} — {site.clinica.cidade}/{site.clinica.uf}
    </p>
    <div class="mapa__acoes">
      <button type="button" class="botao botao--contorno" data-carregar-mapa>Ver mapa</button>
      <a class="botao" href={comoChegarUrl} target="_blank" rel="noopener" data-evento="como-chegar" data-origem="mapa">
        Como chegar
      </a>
    </div>
    <p class="mapa__aviso">O mapa é fornecido pelo Google Maps.</p>
  </div>
</div>

<style>
  .mapa {
    position: relative;
    width: 100%;
    border-radius: var(--raio);
    overflow: hidden;
    background:
      linear-gradient(rgba(36, 90, 102, 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(36, 90, 102, 0.07) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--petroleo-tom);
  }

  @media (min-width: 48rem) {
    .mapa {
      aspect-ratio: 4 / 3;
    }
  }

  .mapa__capa {
    position: relative;
    min-height: 22rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    text-align: center;
  }

  .mapa__capa > :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--petroleo);
  }

  .mapa__acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .mapa__acoes .botao {
    cursor: pointer;
    font-family: inherit;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
  }

  .mapa__aviso {
    font-size: 0.8125rem;
    color: var(--cinza-texto);
  }

  .mapa:has(iframe) {
    min-height: 22rem;
  }

  .mapa :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((mapa) => {
    mapa.querySelector('[data-carregar-mapa]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = mapa.dataset.mapa!;
      iframe.title = 'Mapa da Clínica Mirindiba, Asa Norte, Brasília';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      mapa.querySelector('.mapa__capa')?.remove();
      mapa.appendChild(iframe);
    });
  });
</script>

---
// Barra discreta de consentimento, exibida só quando há ID do Google Analytics configurado.
import { link, site } from '../site.config';

const ativo = Boolean(site.analytics.googleAnalyticsId);
---

{
  ativo && (
    <div class="consentimento" role="region" aria-label="Preferências de cookies" hidden>
      <p>
        Usamos cookies do Google Analytics para entender como o site é usado. Nenhum dado de saúde é coletado.{' '}
        <a href={link('/privacidade/')}>Saiba mais</a>
      </p>
      <div class="consentimento__acoes">
        <button type="button" class="botao" data-consentimento="aceito">
          Aceitar
        </button>
        <button type="button" class="botao botao--contorno" data-consentimento="recusado">
          Recusar
        </button>
      </div>
    </div>
  )
}

<style>
  .consentimento {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: calc(var(--barra-mobile) + 1rem);
    z-index: 60;
    max-width: 34rem;
    padding: 1.25rem;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.3);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .consentimento[hidden] {
    display: none;
  }

  .consentimento__acoes {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .consentimento .botao {
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    cursor: pointer;
    font-family: inherit;
  }

  @media (min-width: 48rem) {
    .consentimento {
      right: auto;
      left: 1.5rem;
      bottom: 1.5rem;
    }
  }
</style>

<script>
  const CHAVE = 'consentimento-cookies';
  const barra = document.querySelector<HTMLElement>('.consentimento');

  function lerEscolha() {
    try {
      return localStorage.getItem(CHAVE);
    } catch {
      return null;
    }
  }

  if (barra) {
    if (!lerEscolha()) barra.hidden = false;

    barra.querySelectorAll<HTMLButtonElement>('[data-consentimento]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const escolha = botao.dataset.consentimento!;
        try {
          localStorage.setItem(CHAVE, escolha);
        } catch {}
        barra.hidden = true;
        if (escolha === 'aceito') (window as any).carregarGA?.();
        // Recusar depois de ter aceitado: recarrega para descarregar o GA.
        else if ((window as any).__gaCarregado) location.reload();
      });
    });
  }

  document.querySelectorAll('[data-abrir-consentimento]').forEach((el) => {
    if (!barra) {
      (el as HTMLElement).hidden = true;
      return;
    }
    el.addEventListener('click', () => {
      barra.hidden = false;
      barra.querySelector('button')?.focus();
    });
  });
</script>

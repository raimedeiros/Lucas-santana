---
// Barra discreta de consentimento, exibida só quando há ID do Google Analytics configurado.
import { link, site } from '../site.config';

const ativo = Boolean(site.analytics.googleAnalyticsId);
---

{
  ativo && (
    <div class="consentimento" role="region" aria-label="Preferências de cookies" hidden>
      <p>
        Usamos cookies do Google Analytics para entender como o site é usado. Nenhum dado de saúde é coletado.{' '}
        <a href={link('/privacidade/')}>Saiba mais</a>
      </p>
      <div class="consentimento__acoes">
        <button type="button" class="botao" data-consentimento="aceito">
          Aceitar
        </button>
        <button type="button" class="botao botao--contorno" data-consentimento="recusado">
          Recusar
        </button>
      </div>
    </div>
  )
}

<style>
  /* Mobile: faixa enxuta presa ao rodapé da tela. Enquanto está aberta, o botão flutuante e a barra
     "Agendar consulta" do mobile ficam escondidos (classe .consentimento-aberto, ver CtaFixo). */
  .consentimento {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.5rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: var(--branco);
    border-top: 1px solid var(--linha);
    box-shadow: 0 -8px 24px -18px rgba(0, 0, 0, 0.35);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .consentimento[hidden] {
    display: none;
  }

  .consentimento p {
    flex: 1 1 18rem;
    margin: 0;
  }

  .consentimento__acoes {
    display: flex;
    gap: 0.5rem;
    flex: 0 0 auto;
  }

  .consentimento .botao {
    min-height: 2.5rem;
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: inherit;
  }

  @media (max-width: 47.99rem) {
    .consentimento__acoes {
      flex: 1 1 100%;
    }

    .consentimento .botao {
      flex: 1;
    }
  }

  /* Desktop/tablet: cartão compacto no canto inferior direito. No topo da Home esse canto
     fica sobre a foto, não sobre texto ou botões — uma barra de largura total cobriria a
     linha do CRM/RQE em telas de 720 px de altura. */
  @media (min-width: 48rem) {
    .consentimento {
      inset: auto 1.5rem 1.5rem auto;
      max-width: 25rem;
      padding: 1rem 1.25rem;
      border: 1px solid var(--linha);
      border-radius: var(--raio);
      box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.35);
    }
  }
</style>

<script>
  const CHAVE = 'consentimento-cookies';
  const barra = document.querySelector<HTMLElement>('.consentimento');

  function lerEscolha() {
    try {
      return localStorage.getItem(CHAVE);
    } catch {
      return null;
    }
  }

  if (barra) {
    const mostrar = (aberto: boolean) => {
      barra.hidden = !aberto;
      document.documentElement.classList.toggle('consentimento-aberto', aberto);
    };
    if (!lerEscolha()) mostrar(true);

    barra.querySelectorAll<HTMLButtonElement>('[data-consentimento]').forEach((botao) => {
      botao.addEventListener('click', () => {
        const escolha = botao.dataset.consentimento!;
        try {
          localStorage.setItem(CHAVE, escolha);
        } catch {}
        mostrar(false);
        if (escolha === 'aceito') (window as any).carregarGA?.();
        // Recusar depois de ter aceitado: recarrega para descarregar o GA.
        else if ((window as any).__gaCarregado) location.reload();
      });
    });
  }

  document.querySelectorAll('[data-abrir-consentimento]').forEach((el) => {
    if (!barra) {
      (el as HTMLElement).hidden = true;
      return;
    }
    el.addEventListener('click', () => {
      document.documentElement.classList.add('consentimento-aberto');
      barra.hidden = false;
      barra.querySelector('button')?.focus();
    });
  });
</script>

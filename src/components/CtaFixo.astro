---
// Botão flutuante (desktop) e barra fixa inferior (celular), sempre levando ao WhatsApp.
import { site, whatsappUrl } from '../site.config';
import Icone from './Icone.astro';
---

<a class="cta-flutuante" href={whatsappUrl} target="_blank" rel="noopener" data-evento="whatsapp" data-origem="botao-flutuante">
  <Icone nome="whatsapp" />
  <span>Agendar consulta</span>
  <span class="sr-only">(abre o WhatsApp)</span>
</a>

<div class="barra-mobile">
  <a class="botao" href={whatsappUrl} target="_blank" rel="noopener" data-evento="whatsapp" data-origem="barra-mobile">
    <Icone nome="whatsapp" />
    <span>Agendar consulta</span>
    <span class="sr-only">pelo WhatsApp com {site.whatsapp.secretaria} (abre o WhatsApp)</span>
  </a>
</div>

<style>
  .cta-flutuante {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.35rem 0.9rem 1.1rem;
    border-radius: 999px;
    background: var(--petroleo);
    color: var(--branco);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 30px -12px rgba(27, 70, 80, 0.55);
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.3s ease;
  }

  .cta-flutuante:hover {
    background: var(--petroleo-escuro);
    color: var(--branco);
    transform: translateY(-2px);
  }

  .cta-flutuante :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* Some quando já há um botão de agendar na tela ou o rodapé está visível,
     para nunca cobrir links e botões (ver script abaixo). */
  :global(.cta-fixo-oculto) .cta-flutuante,
  :global(.consentimento-aberto) .cta-flutuante {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .barra-mobile {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: rgba(247, 247, 245, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--linha);
    transition: transform 0.25s ease, visibility 0.25s;
  }

  :global(.cta-fixo-oculto) .barra-mobile,
  :global(.consentimento-aberto) .barra-mobile {
    transform: translateY(100%);
    visibility: hidden;
  }

  .barra-mobile .botao {
    width: 100%;
  }

  @media (max-width: 47.99rem) {
    :global(:root) {
      --barra-mobile: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 48rem) {
    .barra-mobile {
      display: none;
    }

    .cta-flutuante {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-flutuante,
    .barra-mobile {
      transition: none;
    }
  }

  @media print {
    .barra-mobile,
    .cta-flutuante {
      display: none !important;
    }
  }
</style>

<script>
  // Esconde o botão flutuante e a barra mobile enquanto houver, na tela, outro botão de agendar
  // ou o rodapé — assim eles nunca ficam por cima de links e botões.
  const alvos = [
    ...document.querySelectorAll('[data-evento="whatsapp"]:not(.cta-flutuante):not(.barra-mobile *):not(.cabecalho *)'),
    ...document.querySelectorAll('footer.rodape'),
  ];
  if ('IntersectionObserver' in window && alvos.length) {
    const visiveis = new Set<Element>();
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target);
      document.documentElement.classList.toggle('cta-fixo-oculto', visiveis.size > 0);
    });
    alvos.forEach((el) => obs.observe(el));
  }
</script>

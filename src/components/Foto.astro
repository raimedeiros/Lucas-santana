---
// Foto do Lucas. Enquanto a sessão de fotos não acontece, mostra um placeholder no formato final.
// Para trocar: coloque a imagem em src/assets/fotos/ e passe `src` (import) aqui.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  formato: 'retrato' | 'paisagem';
  alt: string;
  /** Descrição curta da foto que vai entrar aqui (aparece só no placeholder). */
  legenda: string;
  src?: ImageMetadata;
  eager?: boolean;
  class?: string;
}
const { formato, alt, legenda, src, eager = false, class: classe } = Astro.props;
---

{
  src ? (
    <figure class:list={['foto', `foto--${formato}`, classe]}>
      <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 40vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
    </figure>
  ) : (
    <figure class:list={['foto', `foto--${formato}`, 'foto--placeholder', classe]} role="img" aria-label={alt}>
      <figcaption aria-hidden="true">Foto: {legenda}</figcaption>
    </figure>
  )
}

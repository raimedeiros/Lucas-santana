---
// Foto do Lucas. Sem `src`, mostra um placeholder no formato final.
// Para trocar: coloque a imagem em src/assets/fotos/ e passe `src` (import) aqui.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  formato: 'retrato' | 'paisagem';
  alt: string;
  /** Descrição curta da foto que vai entrar aqui (aparece só no placeholder). */
  legenda: string;
  src?: ImageMetadata;
  /** Enquadramento no corte (CSS object-position), ex.: 'center 25%'. */
  posicao?: string;
  /** Aproximação (1 = sem zoom). Amplia em torno de `posicao`. */
  zoom?: number;
  eager?: boolean;
  class?: string;
}
const { formato, alt, legenda, src, posicao = 'center', zoom = 1, eager = false, class: classe } = Astro.props;

// Nunca amplia além do tamanho original da foto.
const larguras = src ? [400, 640, 960, 1280].filter((w) => w < src.width).concat(src.width) : [];
---

{
  src ? (
    <figure class:list={['foto', `foto--${formato}`, classe]}>
      <Image
        src={src}
        alt={alt}
        widths={larguras}
        sizes="(min-width: 60rem) 34vw, 90vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        style={`object-position: ${posicao};${zoom !== 1 ? ` transform: scale(${zoom}); transform-origin: ${posicao};` : ''}`}
      />
    </figure>
  ) : (
    <figure class:list={['foto', `foto--${formato}`, 'foto--placeholder', classe]} role="img" aria-label={alt}>
      <figcaption aria-hidden="true">Foto: {legenda}</figcaption>
    </figure>
  )
}
